{
  "datasets": [
    {
      "name": "feature_status",
      "displayName": "Status Breakdown (Latest)",
      "queryLines": [
        "SELECT\n",
        "  status,\n",
        "  COUNT(*) AS check_count\n",
        "FROM\n",
        "  serverless_stable_h7wanf_catalog.uc_hygiene.feature_check_results\n",
        "WHERE\n",
        "  scan_date\n",
        "    = (\n",
        "      SELECT\n",
        "        MAX(scan_date)\n",
        "      FROM\n",
        "        serverless_stable_h7wanf_catalog.uc_hygiene.feature_check_results\n",
        "    )\n",
        "GROUP BY\n",
        "  status"
      ]
    },
    {
      "name": "feature_score",
      "displayName": "Feature Score (Latest)",
      "queryLines": [
        "SELECT\n",
        "  ROUND(\n",
        "    100.0\n",
        "      * SUM(\n",
        "        CASE\n",
        "          WHEN status = 'PASSED' THEN 1\n",
        "          ELSE 0\n",
        "        END\n",
        "      )\n",
        "      / NULLIF(\n",
        "        SUM(\n",
        "          CASE\n",
        "            WHEN status IN ('PASSED', 'FAILED') THEN 1\n",
        "            ELSE 0\n",
        "          END\n",
        "        ),\n",
        "        0\n",
        "      ),\n",
        "    1\n",
        "  ) AS score_pct,\n",
        "  CAST(100 AS DOUBLE) AS target_score,\n",
        "  SUM(\n",
        "    CASE\n",
        "      WHEN status = 'PASSED' THEN 1\n",
        "      ELSE 0\n",
        "    END\n",
        "  ) AS passed,\n",
        "  SUM(\n",
        "    CASE\n",
        "      WHEN status = 'FAILED' THEN 1\n",
        "      ELSE 0\n",
        "    END\n",
        "  ) AS failed,\n",
        "  SUM(\n",
        "    CASE\n",
        "      WHEN status = 'SKIPPED' THEN 1\n",
        "      ELSE 0\n",
        "    END\n",
        "  ) AS skipped\n",
        "FROM\n",
        "  serverless_stable_h7wanf_catalog.uc_hygiene.feature_check_results\n",
        "WHERE\n",
        "  scan_date\n",
        "    = (\n",
        "      SELECT\n",
        "        MAX(scan_date)\n",
        "      FROM\n",
        "        serverless_stable_h7wanf_catalog.uc_hygiene.feature_check_results\n",
        "    )"
      ]
    },
    {
      "name": "feature_detail",
      "displayName": "Check Details (Latest)",
      "queryLines": [
        "SELECT\n",
        "  check_name,\n",
        "  tier,\n",
        "  status,\n",
        "  scope_name,\n",
        "  message\n",
        "FROM\n",
        "  serverless_stable_h7wanf_catalog.uc_hygiene.feature_check_results\n",
        "WHERE\n",
        "  scan_date\n",
        "    = (\n",
        "      SELECT\n",
        "        MAX(scan_date)\n",
        "      FROM\n",
        "        serverless_stable_h7wanf_catalog.uc_hygiene.feature_check_results\n",
        "    )\n",
        "ORDER BY\n",
        "  CASE status\n",
        "    WHEN 'FAILED' THEN 1\n",
        "    WHEN 'SKIPPED' THEN 2\n",
        "    WHEN 'PASSED' THEN 3\n",
        "  END,\n",
        "  check_name"
      ]
    },
    {
      "name": "feature_trend",
      "displayName": "Score Trend",
      "queryLines": [
        "SELECT\n",
        "  scan_date,\n",
        "  ROUND(\n",
        "    100.0\n",
        "      * SUM(\n",
        "        CASE\n",
        "          WHEN status = 'PASSED' THEN 1\n",
        "          ELSE 0\n",
        "        END\n",
        "      )\n",
        "      / NULLIF(\n",
        "        SUM(\n",
        "          CASE\n",
        "            WHEN status IN ('PASSED', 'FAILED') THEN 1\n",
        "            ELSE 0\n",
        "          END\n",
        "        ),\n",
        "        0\n",
        "      ),\n",
        "    1\n",
        "  ) AS score_pct\n",
        "FROM\n",
        "  serverless_stable_h7wanf_catalog.uc_hygiene.feature_check_results\n",
        "GROUP BY\n",
        "  scan_date\n",
        "ORDER BY\n",
        "  scan_date"
      ]
    }
  ],
